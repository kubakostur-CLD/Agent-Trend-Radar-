# Skopiuj do .env i uzupełnij. Plik .env nigdy nie trafia do repo.

# Kontakt dopisywany do User-Agenta (Wikimedia wymaga danych kontaktowych w UA)
TR_CONTACT=twoj-email@example.com

# Claude API (etap 4): analiza i klastrowanie tematów
ANTHROPIC_API_KEY=
TR_MODEL_ANALYZE=claude-sonnet-5-5
TR_MODEL_CLUSTER=claude-haiku-5-5

# YouTube Data API v3 (etap 4)
YOUTUBE_API_KEY=

# Telegram (etap 4): token od @BotFather i id czatu
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reddit (moduł domyślnie wyłączony)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
